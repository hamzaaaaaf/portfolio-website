# Headers for the static files in public/ (Cloudflare reads this file; it is
# not served). The Worker sets its own headers on /api/*.

# Every page and file: no sniffing, no framing, and only this site's own
# scripts may run. Styles are inline all over the dashboard, so those stay
# allowed; pictures also come from Steam, PlayStation, Letterboxd and OMDb.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src 'self'; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# Fonts never change under the same name.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Sounds, the boot video and artwork: kept for a day without asking, and for
# a month after that they show at once while a fresh copy is fetched behind.
/assets/sounds/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/assets/video/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/assets/themes/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/assets/ui/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/assets/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/assets/tiles/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/assets/gamerpics/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
